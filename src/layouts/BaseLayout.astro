---
import "@fontsource/fraunces/600.css";
import "@fontsource/fraunces/700.css";
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/global.css";
import { site } from "../config/site";

interface Props {
  title: string;
  description?: string;
  active?: string;
  focused?: boolean; // true = hide the global side nav (used by course pages)
}

const {
  title,
  description = site.seo.defaultDescription,
  active = "home",
  focused = false,
} = Astro.props;

const socialPaths: Record<string, string> = {
  github:
    "M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.5v-2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17 4.7 18 5 18 5c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.6.8.5 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z",
  linkedin:
    "M20.5 2h-17A1.5 1.5 0 0 0 2 3.5v17A1.5 1.5 0 0 0 3.5 22h17a1.5 1.5 0 0 0 1.5-1.5v-17A1.5 1.5 0 0 0 20.5 2zM8 19H5v-9h3zM6.5 8.3a1.7 1.7 0 1 1 0-3.5 1.7 1.7 0 0 1 0 3.5zM19 19h-3v-4.7c0-1.1 0-2.6-1.6-2.6S12.6 13 12.6 14.2V19h-3v-9h2.9v1.2h.1a3.2 3.2 0 0 1 2.9-1.6c3.1 0 3.7 2 3.7 4.7z",
  instagram:
    "M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.3 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.1.4.3 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.3 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.1-1 .3-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.3-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.1-.4-.3-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c.1-1.2.3-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.1 1-.3 2.2-.4C8.4 2.2 8.8 2.2 12 2.2z",
};
const visibleSocials = site.socials.filter((s) => s.show);

// Hide the "work" nav link until the work feature is on. Every other nav
// item is always shown. Flip site.features.work to true to bring it back.
const navItems = site.nav.filter((n) => n.key !== "work" || site.features.work);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
    <style is:global>
      /* Focused mode: course/series pages hide the global side nav and let
         content use the full width. A small wordmark tile links home. */
      body.focused .side {
        display: none;
      }
      body.focused .main {
        margin-left: 0;
      }
      /* Wider container so the rail + content use the space instead of being
         squeezed into a centered 920px column. */
      body.focused .wrap {
        max-width: 1280px;
        padding: 0 56px;
      }
      /* Cap the lesson reading column so lines do not stretch too wide. */
      body.focused .cmain {
        max-width: 820px;
      }
      body.focused .focusmark {
        position: fixed;
        top: 22px;
        left: 26px;
        z-index: 30;
        display: inline-flex;
        text-decoration: none;
      }
      body.focused .focusmark .ftile {
        display: inline-grid;
        place-items: center;
        width: 34px;
        height: 34px;
        border-radius: 9px;
        background: var(--accent);
        color: #04181c;
        font-family: "Fraunces", serif;
        font-weight: 700;
        font-size: 20px;
        line-height: 1;
        box-shadow: 0 0 22px rgba(34, 211, 238, 0.35);
        transition: transform 0.14s;
      }
      body.focused .focusmark:hover .ftile {
        transform: translateY(-1px);
      }
      @media (max-width: 900px) {
        body.focused .focusmark {
          top: 14px;
          left: 14px;
        }
      }
    </style>
  </head>
  <body class={focused ? "focused" : undefined}>
    <div class="introcode" id="cw">
      <div class="codeline" id="code">
        <span class="caret" id="caret"></span>
      </div>
    </div>

    <div class="glow" id="glow"></div>

    {
      focused ? (
        <a class="focusmark" href="/" aria-label="Home">
          <span class="ftile">{site.wordmark.tile}</span>
        </a>
      ) : (
        <div class="side">
          <div class="lockA">
            <span class="tile">{site.wordmark.tile}</span>
            <span class="rest">{site.wordmark.rest}</span>
          </div>
          <div class="navwrap">
            <nav>
              {navItems.map((n) => (
                <a href={n.href} class={active === n.key ? "on" : ""}>
                  <span class="sl">/</span>
                  {n.label}
                </a>
              ))}
            </nav>
          </div>
          <div class="botblock">
            <div class="socs">
              {visibleSocials.map((s) => (
                <a class="soc" href={s.href} aria-label={s.platform}>
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d={socialPaths[s.platform]} />
                  </svg>
                </a>
              ))}
            </div>
            <div class="joke">{site.sidebarJoke}</div>
          </div>
        </div>
      )
    }

    <div class="main">
      <slot />
    </div>

    <script>
      const g = document.getElementById("glow");
      if (g) {
        addEventListener("mousemove", (e) => {
          g.style.left = e.clientX + "px";
          g.style.top = e.clientY + "px";
        });
      }

      const cw = document.getElementById("cw");
      const reduceMotion = matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      const seen = sessionStorage.getItem("introSeen");

      if (cw && (reduceMotion || seen)) {
        cw.remove();
      } else if (cw) {
        sessionStorage.setItem("introSeen", "1");
        const segs: [string, string][] = [
          ["<", "a"],
          ["Ramakrishna", "i"],
          [" ", "i"],
          ["role", "t"],
          ["=", "m"],
          ['"software engineer"', "s"],
          [" />", "a"],
        ];
        const code = document.getElementById("code");
        const caret = document.getElementById("caret");
        let si = 0,
          ci = 0,
          el: HTMLSpanElement | null = null;

        const fin = () => {
          cw.classList.add("out");
          setTimeout(() => cw.remove(), 520);
        };

        const t = () => {
          if (si >= segs.length) {
            setTimeout(fin, 320);
            return;
          }
          const seg = segs[si];
          if (ci === 0 && code && caret) {
            el = document.createElement("span");
            el.className = "cc-" + seg[1];
            code.insertBefore(el, caret);
          }
          if (el) el.textContent += seg[0][ci];
          ci++;
          if (ci >= seg[0].length) {
            si++;
            ci = 0;
          }
          setTimeout(t, 27);
        };
        setTimeout(t, 140);
      }
    </script>
  </body>
</html>
