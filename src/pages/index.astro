---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import { site } from "../config/site";
import { home } from "../config/home";

const r = home.about.ram;
const profIcons = [
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="5" r="2.3"></circle><circle cx="5" cy="18" r="2.3"></circle><circle cx="19" cy="18" r="2.3"></circle><path d="M12 7.3V13M12 13l-5.2 3M12 13l5.2 3"></path></svg>',
  '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.5l1.7 5.8L19.5 10l-5.8 1.7L12 17.5l-1.7-5.8L4.5 10l5.8-1.7z"></path><circle cx="18.5" cy="4.5" r="1.2"></circle></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 8l-4 4 4 4M15 8l4 4-4 4"></path></svg>',
];
---

<BaseLayout title={`${site.name} — Software Engineer`} active="home">
  <!-- hero -->
  <div class="hero" id="top">
    <div class="photoA"></div>
    <div class="htext">
      <div class="eye" set:html={home.hero.eyebrow} />
      <h1>{home.hero.name}</h1>
      <div class="sub">{home.hero.sub}</div>
      <p class="lead">{home.hero.lead}</p>
      <div class="cta">
        <a class="btn" href={home.hero.workHref} set:html={site.ui.seeWork} />
        <a class="reslink" href={site.resumePath} download set:html={site.ui.resume} />
      </div>
    </div>
  </div>

  <!-- about -->
  <div class="section" id="about">
    <div class="wrap">
      {home.about.label && <div class="slabel">{home.about.label}</div>}
      <h2>{home.about.heading}</h2>
      <div class="bio">
        {home.about.paragraphs.map((p) => <p>{p}</p>)}
      </div>
      <pre class="codecard" style="max-width:680px;margin-top:26px"><span class="kw">const</span> ram = {"{"}
  role: <span class="st">"{r.role}"</span>,
  builds: <span class="st">"{r.builds}"</span>,
  focus: [{r.focus.map((f, i) => (<><span class="st">"{f}"</span>{i < r.focus.length - 1 ? ", " : ""}</>))}],
  caresAbout: [{r.caresAbout.map((c, i) => (<><span class="st">"{c}"</span>{i < r.caresAbout.length - 1 ? ", " : ""}</>))}],
  currently: <span class="st">"{r.currently}"</span>,
  openToWork: <span class="bool">{String(r.openToWork)}</span>,
{"}"};</pre>
    </div>
  </div>

  <!-- proficiencies -->
  <div class="section">
    <div class="wrap">
      <div class="slabel c">{home.proficiencies.label}</div>
      <h2 class="center">{home.proficiencies.heading}</h2>
      <div class="prof">
        {
          home.proficiencies.items.map((p, i) => (
            <div class="pbox">
              <div class="ic" set:html={profIcons[i]} />
              <h3 set:html={p.title} />
              <p>{p.desc}</p>
              <div class="pt">{p.tags}</div>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- journey (moved above work) -->
  <div class="section">
    <div class="wrap">
      <div class="slabel c">{home.journey.label}</div>
      <h2 class="center">{home.journey.heading}</h2>
      <div class="tl">
        {
          home.journey.items.map((j) => (
            <div class="item">
              <span class="node" />
              <div class="yr">{j.yr}</div>
              <div class="ro">
                {j.role} <span class="co">{j.co}</span>
              </div>
              <div class="cx">{j.cx}</div>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- work -->
  <div class="section" id="work">
    <div class="wrap">
      {home.work.label && <div class="slabel">{home.work.label}</div>}
      <h2>{home.work.heading}</h2>
      <div class="pcards">
        {
          home.work.projects.map((p) => (
            <div class="pcard">
              <div class={`img ${p.img}`}>[ project image ]</div>
              <div class="pb">
                <div class="badge">{p.badge}</div>
                <h3>{p.title}</h3>
                <div class="desc">{p.desc}</div>
                <div class="chips">
                  {p.chips.map((c) => (
                    <span class="chip">{c}</span>
                  ))}
                </div>
                <div class="links">
                  {p.demoHref && <a href={p.demoHref} set:html={site.ui.liveDemo} />}
                  {p.writeupHref && (
                    <a href={p.writeupHref} set:html={site.ui.writeup} />
                  )}
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- skills -->
  <div class="section">
    <div class="wrap">
      <div class="slabel c">{home.skills.label}</div>
      <h2 class="center">{home.skills.heading}</h2>
      <div class="skills">
        {
          home.skills.items.map((s) => (
            <div class="sk">
              {s.icon ? (
                <Icon name={`simple-icons:${s.icon}`} />
              ) : (
                <span class="lt">{s.label.charAt(0)}</span>
              )}
              <span class="txt">{s.label}</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- consult / contact -->
  <div class="section" id="consult">
    <div class="wrap">
      <div class="slabel c">{home.consult.label}</div>
      <h2 class="center">{home.consult.heading}</h2>
      <p class="clead">{home.consult.lead}</p>
      <div class="cactions">
        <a class="btn" href={`mailto:${site.email}`} set:html={site.ui.emailMe} />
        <a class="calllink" href={site.scheduling} set:html={site.ui.bookCall} />
      </div>
      <button class="cmeta" id="copyEmail" type="button" data-email={site.email}>
        <span id="copyEmailText">{site.email}</span>
        &nbsp;·&nbsp; click to copy
      </button>
    </div>
  </div>

  <script>
    const copyBtn = document.getElementById("copyEmail");
    const copyText = document.getElementById("copyEmailText");
    if (copyBtn && copyText) {
      const email = copyBtn.dataset.email || "";
      const original = copyText.textContent;
      copyBtn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(email);
        } catch {
          const t = document.createElement("textarea");
          t.value = email;
          document.body.appendChild(t);
          t.select();
          document.execCommand("copy");
          document.body.removeChild(t);
        }
        copyText.textContent = "Copied to clipboard";
        setTimeout(() => (copyText.textContent = original), 1600);
      });
    }
  </script>

  <!-- footer -->
  <div class="foot">
    <div class="wrap" style="display:flex;justify-content:space-between;width:100%">
      <span>{site.footer.left}</span>
      <span>{site.footer.right}</span>
    </div>
  </div>
</BaseLayout>
